// Prisma Schema for Notion Clone
// Data model for pages, databases, and rows

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Page {
  id        String   @id @default(uuid())
  title     String
  icon      String?
  content   String   // JSON format for BlockNote state
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Page?    @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Page[]   @relation("PageHierarchy")
}

model Database {
  id        String   @id @default(uuid())
  title     String
  icon      String?
  schema    String   // JSON string representing columns: Name, Status, Tags, etc.
  rows      Row[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Row {
  id         String   @id @default(uuid())
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  properties String   // JSON string mapping column IDs to values
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
