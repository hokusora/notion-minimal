# AWS S3 Storage Configuration
# If configured, file uploads via /api/upload generate authentic S3 PutObject presigned URLs.
# If omitted or left as mock, the application automatically falls back to local simulated storage.
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="my-notion-clone-bucket"
# Optional folder prefix inside your bucket (defaults to 'notion-clone/uploads')
# This ensures zero collision with existing folders or files in your bucket
AWS_S3_FOLDER_PREFIX="notion-clone/uploads"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
